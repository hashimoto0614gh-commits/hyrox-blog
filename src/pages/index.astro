---
import BaseLayout      from '@/layouts/BaseLayout.astro';
import Header          from '@/components/Header.astro';
import Hero            from '@/components/Hero.astro';
import BentoGrid       from '@/components/BentoGrid.astro';
import WordPressPosts   from '@/components/WordPressPosts.astro';
import Newsletter      from '@/components/Newsletter.astro';
import Footer          from '@/components/Footer.astro';
import '@/styles/global.css';

/**
 * WordPress サイト URL をここに設定する。
 * 未設定（空文字）の場合はプレースホルダー記事を表示する。
 */
const WP_ENDPOINT = import.meta.env.WP_ENDPOINT ?? '';
---

<BaseLayout
  title="HYROX PORTAL — 競技×経営×育児の数値記録メディア"
  description="HYROX競技者・スタートアップ経営者・父親。VO2max 52、タイム1:18:42。週5早朝4:50トレーニングと経営ログを数値で公開する。"
>
  <Header />

  <main>
    <Hero />
    <BentoGrid />
    <WordPressPosts
      endpoint={WP_ENDPOINT}
      perPage={6}
      heading="Latest Articles"
    />
    <Newsletter />
  </main>

  <Footer />
</BaseLayout>
