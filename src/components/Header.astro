---
const navLinks = [
  { href: '#bento',        label: 'DATA' },
  { href: '#posts',        label: 'ARTICLES' },
  { href: '#about',        label: 'ABOUT' },
];
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50">
  <!-- Top border: yellow line -->
  <div class="h-[2px] bg-hyrox-yellow w-full"></div>

  <!-- Nav bar -->
  <div
    id="nav-bar"
    class="bg-surface-base/90 backdrop-blur-md border-b border-subtle transition-all duration-300"
  >
    <div class="container-site flex items-center justify-between h-14 md:h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 group" aria-label="HYROX PORTAL ホーム">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
          <rect width="28" height="28" fill="#FFFF00"/>
          <text x="4" y="21" font-family="Arial Black,sans-serif" font-size="18"
                font-weight="900" fill="#0A0A0A">H</text>
        </svg>
        <span class="font-black text-white text-sm tracking-[0.15em] uppercase
                     group-hover:text-hyrox-yellow transition-colors duration-200">
          HYROX PORTAL
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-8" aria-label="メインナビゲーション">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="label-xs text-ink-muted hover:text-white transition-colors duration-200"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- CTA -->
      <div class="flex items-center gap-3">
        <a href="#newsletter" class="btn-primary text-xs py-2.5 px-5">
          Weekly Log 購読
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('nav-bar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 60) {
      header?.classList.add('shadow-lg', 'shadow-black/50');
    } else {
      header?.classList.remove('shadow-lg', 'shadow-black/50');
    }
  }, { passive: true });
</script>
