---
---

<section
  class="relative min-h-screen flex flex-col justify-center overflow-hidden bg-surface-base pt-20"
  aria-label="ヒーローセクション"
>
  <!-- Dot grid background -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="
      background-image: radial-gradient(circle, rgba(255,255,0,0.08) 1px, transparent 1px);
      background-size: 40px 40px;
    "
    aria-hidden="true"
  ></div>

  <!-- Vignette over dots -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse 80% 60% at 50% 50%, transparent 20%, #0A0A0A 100%);"
    aria-hidden="true"
  ></div>

  <!-- Yellow left accent bar -->
  <div class="absolute top-0 left-0 w-[3px] h-full bg-hyrox-yellow opacity-70"
       aria-hidden="true"></div>

  <!-- Main content -->
  <div class="container-site relative z-10 py-20 md:py-28">
    <div class="grid lg:grid-cols-[1fr_420px] gap-12 xl:gap-20 items-center">

      <!-- Left: Headline block -->
      <div>
        <!-- Eyebrow -->
        <div class="flex items-center gap-4 mb-8">
          <span class="block w-10 h-[2px] bg-hyrox-yellow"></span>
          <p class="label-yellow">HYROX × 経営 × 育児 — データで語る</p>
        </div>

        <!-- H1 -->
        <h1
          class="font-black text-white leading-[1.0] tracking-tight mb-8"
          style="font-size: clamp(3.5rem, 8vw, 7.5rem);"
        >
          RACE.<br />
          <span class="text-hyrox-yellow" style="font-size: 0.95em;">LEAD.</span><br />
          <span class="text-ink-secondary" style="font-size: 0.5em; font-weight: 700; letter-spacing: 0.05em;">
            PARENT.
          </span>
        </h1>

        <!-- Body copy -->
        <p class="text-ink-secondary text-base md:text-lg max-w-xl mb-10 leading-loose font-light">
          週5 / 早朝4:50 / 3年継続。VO2max を 44 → 52 に引き上げながら、<br class="hidden md:block" />
          スタートアップを経営し、子どもと毎晩風呂に入る。<br class="hidden md:block" />
          その設計図を数値ごと公開する。
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4 mb-12">
          <a href="#pillars" class="btn-primary">
            コンテンツを見る
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a href="#about" class="btn-ghost">
            About →
          </a>
        </div>

        <!-- Inline highlights -->
        <div class="flex flex-wrap gap-6">
          {[
            { val: '1:18:42',  note: 'HYROX PB' },
            { val: 'VO2max 52', note: '2026.02 計測' },
            { val: '週5×早朝',  note: '3年継続中' },
          ].map(item => (
            <div class="flex items-baseline gap-2">
              <span class="font-mono font-bold text-hyrox-yellow text-sm">{item.val}</span>
              <span class="label-xs">{item.note}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Terminal panel -->
      <div class="hidden lg:block">
        <div class="bg-surface-01 border border-subtle">
          <!-- Terminal title bar -->
          <div class="flex items-center gap-2 px-5 py-3.5 border-b border-subtle bg-surface-02">
            <span class="w-3 h-3 rounded-full bg-[#FF5F57]"></span>
            <span class="w-3 h-3 rounded-full bg-[#FFBD2E]"></span>
            <span class="w-3 h-3 rounded-full bg-[#28C840]"></span>
            <span class="label-xs ml-3 text-ink-muted">performance.log — 2026.02.21</span>
          </div>

          <!-- Log lines -->
          <div class="p-6 font-mono space-y-3.5">
            {[
              { key: 'VO2max',            val: '52',       unit: 'ml/kg/min', isNew: true  },
              { key: 'HYROX PB',          val: '1:18:42',  unit: 'total',     isNew: false },
              { key: 'RowErg 1km',        val: '3:28',     unit: '',          isNew: false },
              { key: 'SkiErg 1km',        val: '3:56',     unit: '',          isNew: false },
              { key: 'Roxzone 100m',      val: '1:14',     unit: '',          isNew: false },
              { key: 'WallBall ×100',     val: '4:31',     unit: '',          isNew: false },
              { key: 'Sleep score (avg)', val: '84',       unit: 'pt',        isNew: false },
              { key: 'Deep work / week',  val: '22',       unit: 'h',         isNew: false },
              { key: 'Weight',            val: '72.4',     unit: 'kg',        isNew: false },
            ].map(row => (
              <div class="flex justify-between items-baseline gap-4 text-sm">
                <span class="text-ink-muted text-xs truncate">{row.key}</span>
                <span class="flex items-baseline gap-1.5 flex-shrink-0">
                  {row.isNew && (
                    <span class="text-[9px] font-bold text-green-400 border border-green-400/40 px-1 py-px mr-1">
                      NEW
                    </span>
                  )}
                  <span class="text-hyrox-yellow font-bold tabular-nums">{row.val}</span>
                  {row.unit && <span class="text-ink-muted text-[10px]">{row.unit}</span>}
                </span>
              </div>
            ))}
          </div>

          <!-- Cursor row -->
          <div class="px-6 pb-5 font-mono flex items-center gap-1.5 text-ink-muted text-xs">
            <span class="text-hyrox-yellow">›</span>
            <span>next_race: 2026 HYROX OSAKA</span>
            <span class="inline-block w-1.5 h-3.5 bg-hyrox-yellow animate-pulse ml-1"
                  aria-hidden="true"></span>
          </div>
        </div>

        <p class="label-xs mt-3 text-center">
          Last updated: 2026.02.21 — Garmin Forerunner 265 計測値
        </p>
      </div>

    </div>

    <!-- Bottom stats bar -->
    <div class="mt-16 md:mt-20 grid grid-cols-2 md:grid-cols-4 border border-subtle">
      {[
        { num: '1:18:42', label: 'HYROX ベストタイム',   sub: 'HYROX Japan 2026' },
        { num: '52',      label: 'VO2max (ml/kg/min)',  sub: '2026.02 計測' },
        { num: '3 yrs',   label: '競技歴',              sub: '2023 初出場〜' },
        { num: '5×/wk',   label: '早朝4:50 継続中',     sub: '36ヶ月連続' },
      ].map((stat, i) => (
        <div class={`px-5 py-6 md:py-8 bg-surface-01 hover:bg-surface-02 transition-colors group
                    ${i > 0 ? 'border-l border-subtle' : ''}`}>
          <p class="data-value text-2xl md:text-3xl mb-1 group-hover:scale-105 transition-transform
                     duration-200 inline-block origin-left">
            {stat.num}
          </p>
          <p class="label-xs mt-0.5">{stat.label}</p>
          <p class="text-ink-muted text-[10px] mt-0.5 font-light">{stat.sub}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Scroll cue -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2
              text-ink-muted text-[9px] tracking-widest uppercase select-none"
       aria-hidden="true">
    <span>Scroll</span>
    <span class="block w-px h-8 bg-gradient-to-b from-ink-muted to-transparent animate-pulse"></span>
  </div>
</section>
