---
---

<section
  class="relative min-h-screen flex flex-col justify-center overflow-hidden bg-surface-base pt-20"
  aria-label="ヒーローセクション"
>
  <!-- Subtle grid overlay -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background-image:
      linear-gradient(rgba(255,255,0,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,0,0.03) 1px, transparent 1px);
      background-size: 64px 64px;"
    aria-hidden="true"
  ></div>

  <!-- Yellow left accent -->
  <div class="absolute top-0 left-0 w-0.5 h-full bg-hyrox-yellow opacity-60"
       aria-hidden="true"></div>

  <!-- Main content -->
  <div class="container-site relative z-10 py-20 md:py-28">
    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <!-- Left: Headline -->
      <div>
        <!-- Eyebrow -->
        <p class="label-yellow flex items-center gap-3 mb-8">
          <span class="block w-8 h-px bg-hyrox-yellow"></span>
          HYROX × 経営 × 育児 — データで語る
        </p>

        <!-- H1 -->
        <h1
          class="font-black text-white leading-[1.04] tracking-tight mb-8"
          style="font-size: clamp(3rem, 7vw, 6.5rem);"
        >
          RACE.<br />
          <span class="text-hyrox-yellow">LEAD.</span><br />
          <span class="text-ink-secondary" style="font-size:0.65em; font-weight:700;">
            PARENT.
          </span>
        </h1>

        <!-- Body copy -->
        <p class="text-ink-secondary text-base md:text-lg max-w-lg mb-10 leading-relaxed font-light">
          週5 / 早朝4:50 / 3年継続。VO2max を 44 → 52 に引き上げながら、
          スタートアップを経営し、子どもと毎晩風呂に入る。
          その設計図を数値ごと公開する。
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4">
          <a href="#bento" class="btn-primary">
            データを見る
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                 aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a href="#about" class="btn-ghost">
            About
          </a>
        </div>
      </div>

      <!-- Right: Live metrics panel -->
      <div class="hidden lg:block">
        <div class="bg-surface-01 border border-subtle p-8 font-mono">
          <!-- Terminal header -->
          <div class="flex items-center gap-2 mb-6 pb-4 border-b border-subtle">
            <span class="w-3 h-3 rounded-full bg-red-500"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500"></span>
            <span class="w-3 h-3 rounded-full bg-green-500"></span>
            <span class="label-xs ml-3">performance.log — 2026.02.21</span>
          </div>

          <!-- Log lines -->
          <div class="space-y-3 text-sm">
            {[
              { key: 'VO2max',           val: '52',        unit: 'ml/kg/min' },
              { key: 'HYROX PB',         val: '1:18:42',   unit: 'total' },
              { key: 'RowErg 500m split', val: '1:48.2',   unit: '/500m' },
              { key: 'Roxzone 100m',     val: '1:14',      unit: '' },
              { key: 'SkiErg 1km',       val: '3:28',      unit: '' },
              { key: 'Sleep score avg',  val: '84',        unit: 'pt' },
              { key: 'Deep work / week', val: '22',        unit: 'h' },
            ].map(row => (
              <div class="flex justify-between items-baseline gap-4">
                <span class="text-ink-muted text-xs">{row.key}</span>
                <span class="flex items-baseline gap-1.5">
                  <span class="text-hyrox-yellow font-bold">{row.val}</span>
                  {row.unit && <span class="text-ink-muted text-[10px]">{row.unit}</span>}
                </span>
              </div>
            ))}
          </div>

          <!-- Cursor blink -->
          <div class="mt-6 flex items-center gap-1.5 text-ink-muted text-xs">
            <span class="text-hyrox-yellow">›</span>
            <span>next race: 2026 HYROX OSAKA</span>
            <span class="inline-block w-2 h-3.5 bg-hyrox-yellow animate-pulse ml-1"
                  aria-hidden="true"></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom stats bar -->
    <div class="mt-16 md:mt-24 grid grid-cols-2 md:grid-cols-4 border border-subtle">
      {[
        { num: '1:18:42', label: 'HYROX ベストタイム' },
        { num: '52',      label: 'VO2max (2026.02)' },
        { num: '3 yrs',   label: '競技歴' },
        { num: '5×/wk',   label: '早朝4:50 継続中' },
      ].map((stat, i) => (
        <div class={`px-6 py-6 md:py-8 bg-surface-01 hover:bg-surface-02 transition-colors
                    ${i > 0 ? 'border-l border-subtle' : ''}`}>
          <p class="data-value text-2xl md:text-3xl mb-1.5">{stat.num}</p>
          <p class="label-xs">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Scroll cue -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2
              text-ink-muted text-[10px] tracking-widest uppercase">
    <span>Scroll</span>
    <span class="block w-px h-10 bg-gradient-to-b from-ink-muted to-transparent"></span>
  </div>
</section>
