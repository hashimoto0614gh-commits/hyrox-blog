---
const timeline = [
  { year: '2023', event: 'HYROX 初出場。タイム 1:34:22。スキーエルゴとロクサーで惨敗。' },
  { year: '2024', event: 'トレーニング週5化。VO2max 44→49。PB 1:24:08 に短縮。' },
  { year: '2025', event: 'スタートアップ事業拡大。週22hディープワーク設計を確立。' },
  { year: '2026', event: 'PB 1:18:42 更新。次戦 HYROX OSAKA で Sub 1:15:00 を狙う。' },
];

const metrics = [
  { val: '1:18:42',  label: 'HYROX ベスト' },
  { val: '52',       label: 'VO2max' },
  { val: '3 yrs',    label: '競技歴' },
  { val: '+18%',     label: 'HRV 改善率' },
  { val: '22h/wk',   label: 'ディープワーク' },
  { val: '11mo',     label: '育児ルーティン継続' },
];
---

<section id="about" class="py-20 md:py-28 bg-surface-02" aria-labelledby="about-heading">
  <div class="container-site">

    <div class="grid lg:grid-cols-2 gap-16 xl:gap-24 items-start">

      <!-- Left: story -->
      <div>
        <p class="label-yellow mb-5">ABOUT</p>
        <h2 id="about-heading"
            class="font-black text-white leading-tight mb-8"
            style="font-size: clamp(2rem, 4vw, 3rem);">
          週5 / 早朝4:50 /<br />
          <span class="text-hyrox-yellow">3年継続。</span>
        </h2>

        <div class="space-y-5 text-ink-secondary text-sm leading-relaxed max-w-lg">
          <p>
            スタートアップを経営しながら、HYROX に本格参戦している。
            アメフト部出身で体を動かすことへの抵抗はなかったが、
            30代に入りVO2maxが44まで落ちたのを機に設計を見直した。
          </p>
          <p>
            週5の早朝トレーニングを3年継続し、VO2max を 44→52 に引き上げた。
            PBは 1:18:42。次のターゲットは 2026 HYROX OSAKA で Sub 1:15:00 だ。
          </p>
          <p>
            このブログは「数値で語る」ことを原則にしている。
            「きつかった」ではなく「RowErg 1km 3:28 / SkiErg 1km 3:56」と書く。
            再現性のある情報だけを出す。
          </p>
        </div>

        <!-- Timeline -->
        <div class="mt-10 border-l-2 border-hyrox-yellow/30 pl-6 space-y-6">
          {timeline.map(item => (
            <div class="relative">
              <span class="absolute -left-[29px] top-0.5 w-3 h-3 rounded-full
                           bg-surface-02 border-2 border-hyrox-yellow"></span>
              <p class="label-yellow mb-1">{item.year}</p>
              <p class="text-ink-secondary text-sm leading-relaxed">{item.event}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: metrics grid -->
      <div class="lg:sticky lg:top-24">

        <!-- Metrics grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-px bg-subtle mb-px">
          {metrics.map(m => (
            <div class="bg-surface-01 px-5 py-6 hover:bg-surface-02 transition-colors duration-200">
              <p class="data-value text-2xl md:text-3xl mb-1">{m.val}</p>
              <p class="label-xs">{m.label}</p>
            </div>
          ))}
        </div>

        <!-- Current focus box -->
        <div class="bg-surface-01 border border-hyrox-yellow/20 p-6 font-mono">
          <p class="label-yellow mb-4 flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-hyrox-yellow animate-pulse"></span>
            CURRENT FOCUS
          </p>
          <ul class="space-y-2 text-sm text-ink-secondary">
            <li class="flex items-start gap-2">
              <span class="text-hyrox-yellow mt-0.5">›</span>
              <span>2026 HYROX OSAKA — Target Sub 1:15:00</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-hyrox-yellow mt-0.5">›</span>
              <span>SkiErg 1km → 3:30 以内（現 3:56）</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-hyrox-yellow mt-0.5">›</span>
              <span>VO2max → 55 ml/kg/min（現 52）</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-hyrox-yellow mt-0.5">›</span>
              <span>スタートアップ Q2 OKR 達成率 80%+</span>
            </li>
          </ul>
        </div>

        <!-- CTA -->
        <div class="mt-4 flex gap-3">
          <a href="/about" class="btn-ghost text-xs py-3 px-5 flex-1 justify-center">
            詳しいプロフィール
          </a>
          <a href="#newsletter" class="btn-primary text-xs py-3 px-5 flex-1 justify-center">
            Weekly Log 購読
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
